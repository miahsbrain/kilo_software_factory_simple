# The project control repo lives inside this workspace but is its own git repository.
# The factory never tracks it. See AGENTS.md §"The factory and the project".
/project/

# Agent worktrees: one per board row, created by .kilo/skills/git-worktree/scripts/worktree.py
.kilo/worktrees/
.kilo/local/

# Local review and QA evidence, including reports, ledgers, notes and summaries. Never commit.
artifacts/
artifacts/**/*.png
artifacts/**/*.log
artifacts/**/network.json

# Generated Playwright output, at any depth.
.playwright-mcp/
.playwright/
playwright-report/
test-results/
blob-report/

# Local scratch
/docs/implementation_plans/
.kilo/qa-local/
.tmp/
**/__pycache__/
*.pyc
node_modules/

# Secrets. The agent writes .env.example; the human writes .env.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*

.DS_Store
.vscode/
docs/BOARD.md
**/docs/BOARD.md
!/templates/project/docs/BOARD.md
**/docs/implementation_plans/
./docs/implementation_plans/

