# The project control repo lives inside this workspace but is its own git repository.
# The factory never tracks it. See AGENTS.md §"The factory and the project".
/project/

# The legacy board remains tracked as the first-import source; clone-local runtime state is not.
/docs/BOARD.md
.factory-state/

# Agent worktrees: one per board row, created by .opencode/skills/git-worktree/scripts/worktree.py
.opencode/worktrees/
# BOARD-114 bootstrap only: never move or add new worktrees here.
/.kilo/worktrees/

# QA evidence. The notes and the summaries are tracked; the captures are not.
artifacts/
artifacts/**/*.png
artifacts/**/*.log
artifacts/**/network.json

# Local scratch
.tmp/
**/__pycache__/
*.pyc
node_modules/

# Secrets. The agent writes .env.example; the human writes .env.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*

.DS_Store
.vscode/
