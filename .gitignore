# The project control repo lives inside this workspace but is its own git repository.
# The factory never tracks it. See CLAUDE.md §"The factory and the project".
/project/

# Agent worktrees: one per board row, created by .claude/skills/git-worktree/scripts/worktree.py
.claude/worktrees/
.claude/local/
.claude/settings.local.json

# Local review and QA evidence, including reports, ledgers, notes and summaries. Never commit.
artifacts/
artifacts/**/*.png
artifacts/**/*.log
artifacts/**/network.json

# Generated Playwright output, at any depth.
.playwright-mcp/
.playwright/
playwright-report/
test-results/
blob-report/

# Local scratch
/docs/implementation_plans/
.claude/qa-local/
.tmp/
**/__pycache__/
*.pyc
node_modules/

# Secrets. The agent writes .env.example; the human writes .env.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*

.DS_Store
.vscode/
docs/BOARD.md
**/docs/BOARD.md
!/templates/project/docs/BOARD.md
**/docs/implementation_plans/
./docs/implementation_plans/

# Keep local harness files private, even when the clone excludes .claude/ itself.
