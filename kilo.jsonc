{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "playwright": {
      "command": "playwright-mcp",
      "args": [
        "--executable-path",
        "/usr/bin/chromium",
        "--headless"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git ls-files*": "allow",
      "git blame*": "allow",
      "git describe*": "allow",
      "git cat-file*": "allow",
      "git shortlog*": "allow",
      "git whatchanged*": "allow",
      "git diff-tree*": "allow",
      "git rev-parse*": "allow",
      "git worktree list*": "allow",
      "git branch --show-current*": "allow",
      "git commit --amend*": "ask",
      "git merge*": "ask",
      "git remote*": "ask",
      "git rebase*": "ask",
      "git stash*": "ask",
      "git config*": "ask",
      "git tag*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git branch -d*": "ask",
      "git branch -m*": "ask",
      "git branch -M*": "ask",
      "git branch --delete*": "ask",
      "git branch --force*": "ask",
      "git branch --set-upstream*": "ask",
      "git reset*": "ask",
      "git worktree add*": "ask",
      "git worktree move*": "ask",
      "git worktree prune*": "ask",
      "git fetch*": "ask",
      "git pull*": "ask",
      "git clone*": "ask",
      "git init*": "ask",
      "git submodule*": "ask",
      "git cherry-pick*": "ask",
      "git revert*": "ask",
      "git notes*": "ask",
      "git apply*": "ask",
      "git push*": "deny",
      "git -C * push*": "deny",
      "git clean*": "deny",
      "git checkout --*": "deny",
      "git reset --hard*": "deny",
      "git branch -D*": "deny",
      "git worktree remove*": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "git reflog expire*": "deny",
      "git reflog delete*": "deny",
      "git gc*": "deny",
      "git update-ref -d*": "deny",
      "rm -rf *": "ask"
    },
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      "apps/*/AGENTS.md": "ask",
      ".kilo/agent/*.md": "ask",
      ".kilo/command/*.md": "ask",
      ".kilo/skills/*.md": "ask",
      ".kilo/policies/*.json": "ask",
      ".kilo/scopes/*.md": "ask",
      "docs/BOARD.md": "ask",
      ".env": "deny",
      ".env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "id_rsa*": "deny",
      ".env.example": "allow"
    }
  }
}
