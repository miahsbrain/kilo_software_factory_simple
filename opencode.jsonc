{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "agents": {
    "frontend-dev": { "permissions": [
      { "action": "edit", "resource": "**/artifacts/*/qa/*/*/builder/**", "effect": "allow" }
    ] },
    "backend-dev": { "permissions": [
      { "action": "edit", "resource": "**/artifacts/*/qa/*/*/builder/**", "effect": "allow" }
    ] },
    "mobile-dev": { "permissions": [
      { "action": "edit", "resource": "**/artifacts/*/qa/*/*/builder/**", "effect": "allow" }
    ] },
    "qa-reviewer": { "permissions": [
      { "action": "edit", "resource": "*", "effect": "deny" },
      { "action": "edit", "resource": "**/artifacts/*/qa/*/*/**", "effect": "allow" },
      { "action": "edit", "resource": "**/artifacts/*/qa/*/*/ui.md", "effect": "deny" },
      { "action": "edit", "resource": "**/artifacts/*/qa/*/*/builder/**", "effect": "deny" }
    ] },
    "ui-critic": { "permissions": [
      { "action": "edit", "resource": "*", "effect": "deny" },
      { "action": "edit", "resource": "**/artifacts/*/qa/*/*/ui.md", "effect": "allow" }
    ] }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "playwright-mcp",
          "--executable-path",
          "/usr/bin/chromium",
          "--headless"
        ],
        "timeout": 30000
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    { "action": "factory_guard_approval", "resource": "*", "effect": "ask" },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git add*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git ls-files*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git blame*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git describe*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git cat-file*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git shortlog*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git whatchanged*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff-tree*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git worktree list*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch --show-current*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit --amend*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git merge*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git remote*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git rebase*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git stash*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git config*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git tag*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git checkout*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git switch*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch -d*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch -m*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch -M*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch --delete*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch --force*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch --set-upstream*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git worktree add*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git worktree move*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git worktree prune*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git fetch*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git pull*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clone*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git init*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git submodule*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git cherry-pick*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git revert*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git notes*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git apply*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -C * push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git checkout --*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git branch -D*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git worktree remove*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git filter-branch*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git filter-repo*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reflog expire*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reflog delete*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git gc*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git update-ref -d*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": ".opencode/worktrees/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "**/.opencode/worktrees/**",
      "effect": "allow"
    },
    { "action": "edit", "resource": "artifacts/**", "effect": "deny" },
    { "action": "edit", "resource": "**/artifacts/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.factory-state/reviews/*-ledger.md", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/plugins/*", "effect": "ask" },
    { "action": "edit", "resource": ".opencode/skills/git-worktree/scripts/*", "effect": "ask" },
    { "action": "edit", "resource": "opencode.json*", "effect": "ask" },
    { "action": "edit", "resource": ".git", "effect": "deny" },
    { "action": "edit", "resource": "**/.git", "effect": "deny" },
    { "action": "edit", "resource": ".git/*", "effect": "deny" },
    { "action": "edit", "resource": "**/.git/*", "effect": "deny" },
    {
      "action": "edit",
      "resource": "AGENTS.md",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "apps/*/AGENTS.md",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": ".opencode/agents/*.md",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": ".opencode/commands/*.md",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": ".opencode/skills/*.md",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": ".opencode/policies/*.json",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": ".opencode/scopes/*.md",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "docs/BOARD.md",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/docs/BOARD.md",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".git/config",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.git/config",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.git/config",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".git-credentials",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.git-credentials",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".gitconfig",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.gitconfig",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".npmrc",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.npmrc",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.p12",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "id_rsa*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env.example",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "**/.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".ssh",
      "effect": "deny"
    },
    { "action": "read", "resource": "**/.ssh", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "credentials*", "effect": "deny" },
    { "action": "read", "resource": "**/credentials*", "effect": "deny" },
    {
      "action": "read",
      "resource": ".git/config",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".git/config.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.git/config",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.git/config.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.git/config",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.git/modules/**/config",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".git-credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.git-credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.git-credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".gitconfig",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.gitconfig",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.gitconfig",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.config/git/config",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.config/git/credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.config/git/config",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.config/git/credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".npmrc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.npmrc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.p12",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.p12",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "id_rsa*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/id_rsa*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "**/.env.example",
      "effect": "allow"
    }
  ]
}
