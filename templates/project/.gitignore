# Separate app repositories are ignored/mapped; bootstrap unignores each project-tracked app.
apps/*/

# Assigned linked worktrees; explicitly assigned features may share a worktree/branch.
.kilo/worktrees/
.kilo/local/qa-navigation.json
.kilo/agent-manager.json

# Local review and QA evidence, including reports, ledgers, notes and summaries. Never commit.
artifacts/
artifacts/**/*.png
artifacts/**/*.log
artifacts/**/network.json

# Generated Playwright output, at any depth.
.playwright-mcp/
.playwright/
playwright-report/
test-results/
blob-report/

# Local scratch
.kilo/qa-local/
.tmp/
**/__pycache__/
*.pyc
node_modules/

# Secrets. The agent writes .env.example; the human writes .env.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*

.DS_Store
.vscode/

# The copied project's live board is local; the factory template remains tracked.
/docs/BOARD.md
**/docs/BOARD.md
